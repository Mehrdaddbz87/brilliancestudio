generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubmissionStatus {
  NEW
  REVIEWED
  ARCHIVED
}

model ServicePage {
  id                Int           @id @default(autoincrement())
  slug              String        @unique @default("services")
  eyebrow           String?
  title             String
  description       String
  seoTitle          String?
  seoDescription    String?
  primaryCtaLabel   String?
  primaryCtaHref    String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  sections          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             ServiceItem[]
}

model ServiceItem {
  id          Int         @id @default(autoincrement())
  pageId      Int
  page        ServicePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  slug        String      @unique
  eyebrow     String?
  title       String
  description String
  imageUrl    String?
  imageAlt    String?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([pageId, sortOrder])
}

model ReferencePage {
  id                Int             @id @default(autoincrement())
  slug              String          @unique @default("references")
  eyebrow           String?
  title             String
  description       String
  seoTitle          String?
  seoDescription    String?
  primaryCtaLabel   String?
  primaryCtaHref    String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  sections          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  items             ReferenceItem[]
}

model ReferenceItem {
  id        Int           @id @default(autoincrement())
  pageId    Int
  page      ReferencePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  slug      String        @unique
  category  String?
  title     String
  summary   String
  imageUrl  String?
  imageAlt  String?
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([pageId, sortOrder])
}

model LegalPage {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  eyebrow        String?
  title          String
  description    String
  seoTitle       String?
  seoDescription String?
  sections       Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ContactRequest {
  id        Int              @id @default(autoincrement())
  name      String
  email     String
  service   String           @default("General Inquiry")
  company   String?
  message   String
  status    SubmissionStatus @default(NEW)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status, createdAt])
}

model AdminCredential {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
}
