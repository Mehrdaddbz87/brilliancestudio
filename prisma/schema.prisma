generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tracks the review lifecycle for inbound form submissions.
enum SubmissionStatus {
  NEW
  REVIEWED
  ARCHIVED
}

/// Stores editable page-level content and linked service cards for the services route.
model ServicePage {
  id                Int           @id @default(autoincrement())
  slug              String        @unique @default("services")
  eyebrow           String?
  title             String
  description       String
  seoTitle          String?
  seoDescription    String?
  primaryCtaLabel   String?
  primaryCtaHref    String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  sections          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             ServiceItem[]
}

/// Stores an individual service card that belongs to the services page.
model ServiceItem {
  id          Int         @id @default(autoincrement())
  pageId      Int
  page        ServicePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  slug        String      @unique
  eyebrow     String?
  title       String
  description String
  imageUrl    String?
  imageAlt    String?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([pageId, sortOrder])
}

/// Stores editable page-level content and linked gallery items for the references route.
model ReferencePage {
  id                Int             @id @default(autoincrement())
  slug              String          @unique @default("references")
  eyebrow           String?
  title             String
  description       String
  seoTitle          String?
  seoDescription    String?
  primaryCtaLabel   String?
  primaryCtaHref    String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  sections          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  items             ReferenceItem[]
}

/// Stores an individual reference/gallery item that belongs to the references page.
model ReferenceItem {
  id        Int           @id @default(autoincrement())
  pageId    Int
  page      ReferencePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  slug      String        @unique
  category  String?
  title     String
  summary   String
  imageUrl  String?
  imageAlt  String?
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([pageId, sortOrder])
}

/// Stores legal page content such as terms and imprint sections.
model LegalPage {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  eyebrow        String?
  title          String
  description    String
  seoTitle       String?
  seoDescription String?
  sections       Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Persists contact form submissions for follow-up and audit history.
model ContactRequest {
  id        Int              @id @default(autoincrement())
  name      String
  email     String
  service   String           @default("General Inquiry")
  company   String?
  message   String
  status    SubmissionStatus @default(NEW)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status, createdAt])
}

